{
  "patches-version": "beta",
  "enable-module-update": true,
  "SmashHit-Byehi98-Experimental": {
    "enabled": true,
    "app-name": "Smash Hit",
    "sub-variant": "Experimental",
    "version": "latest",
    "patcher-args": "-f --continue-on-error",
    "skip-patch-app-check": true,
    "pkg-name": "com.mediocre.smashhit",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/mediocre/smash-hit/",
    "uptodown-dlurl": "https://smash-hit.en.uptodown.com/android"
  },
  "BraveBrowser-Kveld9": {
    "patches-source": "kveld9/kveld-morphe-patches",
    "brand": "kveld9",
    "enabled": true,
    "app-name": "Brave Browser",
    "patch-brand": "Kveld9",
    "arch": "arm64-v8a x86_64 armeabi-v7a x86",
    "pkg-name": "com.brave.browser",
    "patcher-args": "--continue-on-error",
    "github-dlurl": "https://github.com/brave/brave-browser/releases",
    "github-asset-regex": "arm64-v8a: BraveMonoarm64\\.apk$ | armeabi-v7a: BraveMonoarm\\.apk$ | x86_64: BraveMonox64\\.apk$ | x86: BraveMonox86\\.apk$",
    "github-release-name-regex": "^Release v"
  },
  "Reddit-Morphe-Experimental": {
    "enabled": true,
    "pkg-name": "com.reddit.frontpage",
    "app-name": "Reddit",
    "patches-source": "MorpheApp/morphe-patches",
    "brand": "Morphe",
    "patches-version": "both",
    "build-mode": "both",
    "variant": "Experimental",
    "version": "exp",
    "apkmirror-dlurl": "https://apkmirror.com/apk/redditinc/reddit",
    "uptodown-dlurl": "https://reddit-official-app.en.uptodown.com/android",
    "apkpure-dlurl": "https://apkpure.com/reddit-app/com.reddit.frontpage",
    "apkcombo-dlurl": "https://apkcombo.com/reddit/com.reddit.frontpage"
  },
  "YouTubeMusic-Morphe-AMOLED-Experimental": {
    "enabled": true,
    "pkg-name": "com.google.android.apps.youtube.music",
    "app-name": "YouTube Music",
    "patches-source": "MorpheApp/morphe-patches",
    "brand": "Morphe",
    "variant": "AMOLED",
    "sub-variant": "Experimental",
    "build-mode": "both",
    "arch": "arm64-v8a x86_64 armeabi-v7a x86",
    "version": "exp",
    "included-patches": "'Theme'",
    "patcher-args": "-OdarkThemeBackgroundColor=#000000",
    "uptodown-dlurl": "https://youtube-music.en.uptodown.com/android",
    "apkmirror-dlurl": "https://apkmirror.com/apk/google-inc/youtube-music",
    "apkpure-dlurl": "https://apkpure.com/youtube-music/com.google.android.apps.youtube.music",
    "apkcombo-dlurl": "https://apkcombo.com/youtube-music/com.google.android.apps.youtube.music"
  }
}
